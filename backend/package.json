{
  "name": "yercaud-backend",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:up": "node-pg-migrate up -j sql",
    "migrate:down": "node-pg-migrate down -j sql",
    "migrate:create": "node-pg-migrate create -j sql",
    "seed:reference": "tsx scripts/seed-reference.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "embeddings:sync": "tsx scripts/embeddings-sync.ts",
    "featured-rankings:sync": "tsx scripts/featured-ranking-sync.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.0",
    "argon2": "^0.41.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.0",
    "google-auth-library": "^10.9.0",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1",
    "pgvector": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
