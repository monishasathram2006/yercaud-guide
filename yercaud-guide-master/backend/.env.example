PORT=4000
DATABASE_URL=postgres://yercaud:yercaud@localhost:5432/yercaud_directory
CORS_ORIGINS=http://localhost:8080,http://localhost:8081

# Azure OpenAI embeddings for the hybrid search engine (issue #11).
# All optional: with none set, the semantic leg is disabled and search runs
# lexical-only (this is the state the test suite and CI run in). Copy to .env
# and fill in to enable semantic ranking locally.
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-10-21

# Google OAuth ("Continue with Google" on the public frontend). Create a Web
# application OAuth client in Google Cloud Console with:
#   - Authorized JavaScript origin: http://localhost:5173
#   - Authorized redirect URI: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
